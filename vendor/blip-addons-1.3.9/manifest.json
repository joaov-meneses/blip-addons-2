{
   "action": {
      "default_popup": "popup.html",
      "default_title": "Blip Addons"
   },
   "background": {
      "service_worker": "js/background.js"
   },
   "content_scripts": [ {
      "js": [ "js/content.js" ],
      "matches": [ "*://*.blip.ai/application/*" ],
      "run_at": "document_end"
   } ],
   "default_locale": "en",
   "description": "Collection of Blip utilities",
   "homepage_url": "https://github.com/pmartinsesa/blip-addons",
   "host_permissions": [ "*://*.blip.ai/application/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Blip Addons",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.3.9",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "js/listener.js" ]
   } ]
}
