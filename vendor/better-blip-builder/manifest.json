{
   "$schema": "https://www.schemastore.org/chrome-manifest.json",
   "action": {
      "default_icon": {
         "16": "icon.png",
         "32": "icon-32px.png"
      },
      "default_popup": "./popup.html"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "./blip-builder.js" ],
      "matches": [ "*://*.blip.ai/*" ],
      "run_at": "document_end"
   } ],
   "description": "Add new features to Blip Builder",
   "host_permissions": [ "*://*.blip.ai/*" ],
   "icons": {
      "128": "icon-128px.png",
      "16": "icon.png",
      "48": "icon-48px.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Better Blip Builder",
   "permissions": [  ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.46",
   "web_accessible_resources": [ {
      "matches": [ "*://*.blip.ai/*" ],
      "resources": [ "assets/inject.css", "assets/CascadiaMono.ttf", "inject.js" ]
   } ]
}
